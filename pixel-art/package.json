{
  "name": "pixel-art",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pixel art as code: sprites, tiles and animations generated by TypeScript, styled by STYLE.md, measured against your references.",
  "scripts": {
    "build": "tsx src/tools/build.ts",
    "preview": "tsx src/tools/preview.ts",
    "anim": "tsx src/tools/anim.ts",
    "analyze": "tsx src/tools/analyze/index.ts",
    "dump": "tsx src/tools/dump.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
